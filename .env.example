# Final public address of the site, no trailing slash (link previews, sitemap, canonical URLs).
# Leave empty on Vercel until the real domain is connected: the project's vercel.app address is used.
NEXT_PUBLIC_SITE_URL=

# SMTP account used to deliver enquiry and callback emails.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where enquiries are delivered
ENQUIRY_TO=info@sereneheightslahore.com
